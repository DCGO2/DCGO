+        if (string.IsNullOrEmpty(senderName))
+            senderName = "Player";
+
+        PhotonView view = GetComponent<PhotonView>();
+        if (view == null)
+            return;
+
+        view.RPC(nameof(ReceiveBattleChat), RpcTarget.All, senderName, sanitized);
+    }
